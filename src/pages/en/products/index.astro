---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductsPage from '../../../components/pages/ProductsPage.astro';
import { products, routes } from '../../../data/content';

const page = products.en;
---

<BaseLayout
  lang="en"
  title={page.meta.title}
  description={page.meta.description}
  path={routes.en.products}
  alternatePath={routes.pt.products}
  ogImage="/og/en/empresa.png"
  ogAlt={page.meta.ogAlt}
>
  <ProductsPage lang="en" />
</BaseLayout>
