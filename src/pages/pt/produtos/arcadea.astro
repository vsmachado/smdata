---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArcadeaPage from '../../../components/pages/ArcadeaPage.astro';
import { arcadeaPage, routes, site } from '../../../data/content';

const page = arcadeaPage.pt;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Arcadea',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows 10, Windows 11, Android',
  softwareVersion: '1.3.1',
  description: page.meta.description,
  url: `https://smdata.net${routes.pt.arcadea}`,
  installUrl: site.arcadea.download,
  inLanguage: 'pt-BR'
};
---

<BaseLayout
  lang="pt"
  title={page.meta.title}
  description={page.meta.description}
  path={routes.pt.arcadea}
  alternatePath={routes.en.arcadea}
  ogImage="/og/pt/arcadea.png"
  ogAlt={page.meta.ogAlt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <ArcadeaPage lang="pt" />
</BaseLayout>
