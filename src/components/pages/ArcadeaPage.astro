---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { arcadeaPage, routes, site, ui, type Lang } from '../../data/content';
import library from '../../assets/screenshots/arcadea/library.png';
import details from '../../assets/screenshots/arcadea/game-details.png';
import deals from '../../assets/screenshots/arcadea/deals.png';
import wishlist from '../../assets/screenshots/arcadea/wishlist.png';
import companionLibrary from '../../assets/screenshots/companion/library.png';
import companionDetails from '../../assets/screenshots/companion/details.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = arcadeaPage[lang];
const t = ui[lang];
const shots = [details, deals, wishlist];

const alts =
  lang === 'pt'
    ? {
        library: 'Biblioteca do Arcadea com Steam, Epic, GOG, Amazon Games e jogos locais',
        companionLibrary: 'Biblioteca do Arcadea no Companion Android',
        companionDetails: 'Página de jogo do Arcadea no Companion Android',
        gallery: [
          'Página de detalhes de Cities: Skylines no Arcadea',
          'Página de ofertas do Arcadea com promoções regionais',
          'Página de wishlist do Arcadea'
        ]
      }
    : {
        library: 'Arcadea library with Steam, Epic, GOG, Amazon Games and local games',
        companionLibrary: 'Arcadea library in the Android Companion',
        companionDetails: 'Arcadea game page in the Android Companion',
        gallery: [
          'Cities: Skylines game details page in Arcadea',
          'Arcadea deals page with regional promotions',
          'Arcadea wishlist page'
        ]
      };
---

<section class="product-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={routes[lang].home}>{page.breadcrumb[0]}</a>
      <span class="sep">/</span>
      <a href={routes[lang].products}>{page.breadcrumb[1]}</a>
      <span class="sep">/</span>
      <span>{page.breadcrumb[2]}</span>
    </nav>

    <div class="product-hero-grid">
      <div class="product-hero-copy">
        <div class="product-logo-row">
          <img class="product-logo" src="/brand/arcadea-mark.png" alt="" width="42" height="42" />
          <span class="eyebrow" style="margin-bottom: 0">{page.hero.kicker}</span>
        </div>

        <h1>{page.hero.name}</h1>
        <p class="product-lead">{page.hero.lead}</p>
        <p class="product-desc">{page.hero.description}</p>

        <div class="action-row">
          <a class="button button-dark" href={site.arcadea.download}>
            {page.hero.primary} <Icon name="download" size={15} />
          </a>
          <a
            class="button button-outline"
            href={site.arcadea.site}
            target="_blank"
            rel="noopener"
          >
            {page.hero.secondary} <Icon name="arrow-up-right" size={14} />
          </a>
        </div>

        <div class="download-links">
          <a class="text-link" href={site.arcadea.portable}>
            {page.hero.portable} <Icon name="arrow-down" size={13} />
          </a>
          <span>{page.hero.note}</span>
        </div>

        <div class="product-meta">
          {
            page.hero.meta.map((item) => (
              <div>
                <span class="meta-label">{item.label}</span>
                <span class="meta-value">{item.value}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="product-hero-visual">
        <div class="hero-shot-frame reveal reveal-delay">
          <div class="app-window-bar">
            <i class="app-window-dot"></i>
            <i class="app-window-dot"></i>
            <i class="app-window-dot"></i>
            <span class="app-window-title">Arcadea</span>
          </div>
          <Image
            src={library}
            alt={alts.library}
            widths={[720, 1000, 1300]}
            sizes="(max-width: 1080px) 90vw, 46vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="hero-phone">
          <div class="phone-frame">
            <span class="phone-speaker"></span>
            <Image
              src={companionLibrary}
              alt={alts.companionLibrary}
              widths={[160, 240, 320]}
              sizes="(max-width: 680px) 104px, 138px"
              format="webp"
              quality={80}
            />
          </div>
        </div>

        <p class="hero-visual-caption">{page.hero.screenshotCaption}</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{page.features.kicker}</span>
      <h2>{page.features.title}</h2>
      <p>{page.features.lead}</p>
    </div>

    <div class="feature-grid reveal">
      {
        page.features.items.map((item, index) => (
          <article class="feature-item">
            <span class="feature-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-rule">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{page.gallery.kicker}</span>
      <h2>{page.gallery.title}</h2>
    </div>

    <div class="gallery-list">
      {
        page.gallery.items.map((item, index) => (
          <div class="gallery-item reveal">
            <div class="gallery-copy">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
            <div>
              <div class="gallery-frame">
                <Image
                  src={shots[index]}
                  alt={alts.gallery[index]}
                  widths={[520, 760, 1000]}
                  sizes="(max-width: 860px) 90vw, 56vw"
                  format="webp"
                  quality={82}
                />
              </div>
              <p class="gallery-caption">{item.caption}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{page.availability.kicker}</span>
      <h2>{page.availability.title}</h2>
    </div>

    <div class="availability">
      {
        page.availability.rows.map((row) => (
          <div class="availability-row">
            <span class="availability-platform">{row.platform}</span>
            <span
              class:list={[
                'availability-state',
                row.state.toLowerCase().includes('roadmap') && 'muted'
              ]}
            >
              {row.state}
            </span>
          </div>
        ))
      }
    </div>
    <p class="availability-note">{page.availability.note}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="dark-panel reveal">
      <span class="eyebrow">{page.privacy.kicker}</span>
      <h2>{page.privacy.title}</h2>
      <p>{page.privacy.text}</p>

      <div class="privacy-grid">
        {
          page.privacy.items.map((item) => (
            <article class="privacy-item">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="section section-rule">
  <div class="container companion-panel">
    <div class="companion-copy">
      <span class="eyebrow">{page.companion.kicker}</span>
      <h2>{page.companion.title}</h2>
      <p>{page.companion.text}</p>
      <ul class="check-list">
        {
          page.companion.bullets.map((item) => (
            <li>
              <Icon name="check" size={14} />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="companion-note">{page.companion.note}</p>
    </div>

    <div class="companion-phones">
      <div class="companion-phone featured">
        <div class="phone-frame">
          <span class="phone-speaker"></span>
          <Image
            src={companionLibrary}
            alt={alts.companionLibrary}
            widths={[180, 260, 360]}
            sizes="(max-width: 680px) 46vw, 196px"
            format="webp"
            quality={82}
          />
        </div>
        <span>{page.companion.screens[0].title}</span>
      </div>
      <div class="companion-phone">
        <div class="phone-frame">
          <span class="phone-speaker"></span>
          <Image
            src={companionDetails}
            alt={alts.companionDetails}
            widths={[160, 240, 320]}
            sizes="(max-width: 680px) 46vw, 172px"
            format="webp"
            quality={82}
          />
        </div>
        <span>{page.companion.screens[1].title}</span>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container next-product">
    <div>
      <span class="next-label">{page.next.label}</span>
      <a class="next-name" href={page.next.path}>{page.next.name} <Icon name="arrow" size={22} /></a>
      <p class="next-text">{page.next.text}</p>
    </div>
    <a class="button button-outline" href={routes[lang].products}>{t.back}</a>
  </div>
</section>
