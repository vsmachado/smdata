---
type IconName =
  | 'arrow'
  | 'arrow-up-right'
  | 'arrow-down'
  | 'check'
  | 'mail'
  | 'chevron-right'
  | 'download'
  | 'home'
  | 'receipt'
  | 'calendar'
  | 'box'
  | 'settings';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
}

const { name, size = 16, stroke = 1.85 } = Astro.props;

const paths: Record<IconName, string> = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6" />',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9" />',
  'arrow-down': '<path d="M12 4v15M6 13l6 6 6-6" />',
  check: '<path d="m4.5 12.5 4.5 4.5L19.5 6.5" />',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.6 6.4 8.4 6.1 8.4-6.1" />',
  'chevron-right': '<path d="m9 5 7 7-7 7" />',
  download: '<path d="M12 3v12M7 10l5 5 5-5M4 20h16" />',
  home: '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" />',
  receipt: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z" /><path d="M9 8h6M9 12h6M9 16h4" />',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" />',
  box: '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z" /><path d="m4 7.5 8 4.5 8-4.5M12 12v9" />',
  settings: '<circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4v-.2a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-2.8-2.8.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3v-4h.2a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1 2.8-2.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V3h4v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 2.8 2.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4h-.2a1.7 1.7 0 0 0-1.6 1z" />'
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
