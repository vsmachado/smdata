---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { routes, type Lang } from '../data/content';
import warehouse from '../assets/services/warehouse-desk.jpg';

interface Props {
  lang: Lang;
  data: {
    kicker: string;
    title: string;
    intro: string;
    emphasis: string;
    items: readonly { title: string; text: string }[];
    cta: string;
    imageAlt: string;
    imageTag: string;
    credit: string;
    creditUrl: string;
  };
}

const { lang, data } = Astro.props;
---

<section class="section section-rule" id="servicos">
  <div class="container services-split">
    <figure class="services-visual">
      <div class="services-image">
        <Image
          src={warehouse}
          alt={data.imageAlt}
          widths={[480, 720, 1000]}
          sizes="(max-width: 1080px) 90vw, 42vw"
          format="webp"
          quality={82}
        />
        <span class="services-tag">{data.imageTag}</span>
      </div>
      <figcaption>
        <a href={data.creditUrl} target="_blank" rel="noopener">{data.credit}</a>
      </figcaption>
    </figure>

    <div class="services-copy">
      <span class="eyebrow">{data.kicker}</span>
      <h2>{data.title}</h2>
      <p>{data.intro}</p>
      <p class="services-emphasis">{data.emphasis}</p>

      <ul class="service-list">
        {
          data.items.map((item, index) => (
            <li>
              <span class="service-index">0{index + 1}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <a class="text-link" href={routes[lang].contact}>
        {data.cta} <Icon name="arrow" size={14} />
      </a>
    </div>
  </div>
</section>
